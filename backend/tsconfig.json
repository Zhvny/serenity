{
  "compilerOptions": {
    "target": "es2023", "lib": ["es2023"], "module": "nodenext",
    "moduleResolution": "nodenext", "outDir": "dist", "rootDir": "src",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "moduleDetection": "force"
  },
  "include": ["src"]
}
