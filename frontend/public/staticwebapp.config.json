{
  "routes": [
    { "route": "/admin*", "statusCode": 403 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "/*.{png,jpg,svg,ico,webp,woff,woff2}"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html" },
    "403": { "rewrite": "/403.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer"
  }
}
